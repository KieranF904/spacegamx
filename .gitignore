# Players' saved ships (runtime data)
game-v2/data/ships/players/

# Players' saved progress (runtime data)
game-v2/data/profiles/

# Contributor notes and ranks (runtime data, kept on the server between deploys)
game-v2/data/contributor/
game-v2/data/status/

# Website posts, comments and uploads (runtime data)
game-v2/data/site/

# Pilot telemetry (runtime data)
game-v2/data/telemetry/

# The world's memory: what's alive, dead and due back in each system (runtime data, kept on the server between deploys)
game-v2/data/world/

# Scratch screenshots
dev-tools/_look*.png

# UX pass screenshots (large; kept locally)
game-v2/docs/ux/polish-*/

# Dev-update before/after images stay local (the index is tracked)
game-v2/docs/panels/**/*.png
