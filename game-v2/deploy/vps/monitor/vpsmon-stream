#!/usr/bin/python3
"""
The VPS's resource use, once a second, as one JSON line each (read by tools/vpsmon on Kieran's PC, over SSH).

The only thing the `vpsmon` account can run (sshd ForceCommand): it reads /proc, systemd's accounting for the services
on the box, and the game's own status file (data/status/live.json), and writes them out. It takes no input and changes
nothing. It stops when the connection does.
"""
import json, os, sys, time, subprocess

UNITS = ['spacegame-server', 'spacegame-browser', 'brotherk3d', 'mealmaker', 'postgresql@18-main', 'nginx']
GAME_STATUS = '/opt/spacegame/data/status/live.json'
TOP = 6


def cpu_times():
    out = {}
    with open('/proc/stat') as f:
        for line in f:
            if not line.startswith('cpu'):
                break
            p = line.split()
            v = list(map(int, p[1:9]))
            idle = v[3] + v[4]
            out[p[0]] = (sum(v), idle)
    return out


def meminfo():
    m = {}
    with open('/proc/meminfo') as f:
        for line in f:
            k, v = line.split(':', 1)
            m[k] = int(v.split()[0]) * 1024
    return m


def net_bytes():
    rx = tx = 0
    with open('/proc/net/dev') as f:
        for line in list(f)[2:]:
            name, rest = line.split(':', 1)
            if name.strip() == 'lo':
                continue
            v = rest.split()
            rx += int(v[0]); tx += int(v[8])
    return rx, tx


def disk_io():
    r = w = 0
    with open('/proc/diskstats') as f:
        for line in f:
            p = line.split()
            # whole disks only (vda, sda, nvme0n1), not their partitions
            if p[2].startswith(('vd', 'sd')) and not p[2][-1].isdigit() or (p[2].startswith('nvme') and 'p' not in p[2][4:]):
                r += int(p[5]) * 512; w += int(p[9]) * 512
    return r, w


def units():
    props = 'Id,ActiveState,CPUUsageNSec,MemoryCurrent,TasksCurrent'
    try:
        txt = subprocess.run(['systemctl', 'show', *[u + '.service' for u in UNITS], '-p', props], capture_output=True, text=True, timeout=2).stdout
    except Exception:
        return {}
    out, cur = {}, {}
    for line in txt.splitlines() + ['']:
        if not line.strip():
            if cur.get('Id'):
                out[cur['Id'].removesuffix('.service')] = cur
            cur = {}
            continue
        k, _, v = line.partition('=')
        cur[k] = v
    return out


def num(v):
    try:
        n = int(v)
        return n if n < 2 ** 63 - 1 else None
    except (TypeError, ValueError):
        return None


TICK = os.sysconf('SC_CLK_TCK')


def procs():
    """Every process's CPU ticks so far, its name and memory"""
    out = {}
    for pid in os.listdir('/proc'):
        if not pid.isdigit():
            continue
        try:
            with open(f'/proc/{pid}/stat') as f:
                s = f.read()
            name = s[s.index('(') + 1:s.rindex(')')]
            rest = s[s.rindex(')') + 2:].split()
            out[int(pid)] = (name, int(rest[11]) + int(rest[12]), int(rest[21]) * 4096)
        except (OSError, ValueError, IndexError):
            continue
    return out


def game():
    try:
        st = os.stat(GAME_STATUS)
        if time.time() - st.st_mtime > 10:
            return None
        with open(GAME_STATUS) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def main():
    ncpu = os.cpu_count() or 1
    prev_cpu, prev_net, prev_io, prev_u, prev_p = cpu_times(), net_bytes(), disk_io(), units(), procs()
    prev_t = time.monotonic()
    while True:
        time.sleep(1)
        now = time.monotonic(); dt = max(1e-3, now - prev_t); prev_t = now
        cpu = cpu_times()
        pct = {}
        for k, (tot, idle) in cpu.items():
            pt, pi = prev_cpu.get(k, (tot, idle))
            dtot = tot - pt
            pct[k] = round(100 * (1 - (idle - pi) / dtot), 1) if dtot > 0 else 0.0
        prev_cpu = cpu
        m = meminfo()
        rx, tx = net_bytes(); prx, ptx = prev_net; prev_net = (rx, tx)
        rd, wr = disk_io(); prd, pwr = prev_io; prev_io = (rd, wr)
        fs = os.statvfs('/')
        u = units()
        svc = {}
        for name, p in u.items():
            c, pc = num(p.get('CPUUsageNSec')), num(prev_u.get(name, {}).get('CPUUsageNSec'))
            svc[name] = {
                'state': p.get('ActiveState'),
                # (a share of one core: 100 is a whole core)
                'cpu': round((c - pc) / 1e9 / dt * 100, 1) if c is not None and pc is not None and c >= pc else None,
                'mem': num(p.get('MemoryCurrent')),
                'tasks': num(p.get('TasksCurrent')),
            }
        prev_u = u
        ps = procs()
        top = []
        for pid, (name, ticks, rss) in ps.items():
            before = prev_p.get(pid)
            if before and before[0] == name:
                top.append((round((ticks - before[1]) / TICK / dt * 100, 1), name, rss, pid))
        prev_p = ps
        top.sort(reverse=True)
        with open('/proc/loadavg') as f:
            load = list(map(float, f.read().split()[:3]))
        with open('/proc/uptime') as f:
            up = float(f.read().split()[0])
        line = {
            't': round(time.time(), 3), 'ncpu': ncpu, 'up': up,
            'cpu': pct.get('cpu', 0), 'cores': [pct[k] for k in sorted(pct) if k != 'cpu'],
            'load': load,
            'mem': {'total': m.get('MemTotal'), 'avail': m.get('MemAvailable'), 'swapTotal': m.get('SwapTotal'), 'swapFree': m.get('SwapFree')},
            'net': {'rx': round((rx - prx) / dt), 'tx': round((tx - ptx) / dt)},
            'io': {'read': round((rd - prd) / dt), 'write': round((wr - pwr) / dt)},
            'disk': {'total': fs.f_blocks * fs.f_frsize, 'free': fs.f_bavail * fs.f_frsize},
            'svc': svc,
            'top': [{'cpu': c, 'name': n, 'rss': r, 'pid': p} for c, n, r, p in top[:TOP]],
            'game': game(),
        }
        try:
            sys.stdout.write(json.dumps(line, separators=(',', ':')) + '\n')
            sys.stdout.flush()
        except (BrokenPipeError, OSError):
            return


if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        pass
