# The website's settings, by name. Copy to .env or export them; nothing here is a real value.
# In production (the VPS) the unit deploy/vps/spacegame-site.service sets the plain ones and reads the secrets from
# /etc/spacegame/secrets.env, which remote-install.sh fills in once. Never commit a real .env.
# The full list, with defaults, is at the top of src/config.ts.

# --- Required in production (the site refuses to start without them) ---
# Signs the forms (CSRF). 32+ random characters:  openssl rand -hex 32
SITE_SECRET=
# The lobby's admin secret: the same value the lobby and the game server use (LOBBY_ADMIN_SECRET there)
LOBBY_ADMIN_SECRET=
# The public https address (RSS links, Origin checks)
SITE_ORIGIN=https://space.example.com

# --- Common ---
NODE_ENV=production
SITE_PORT=8791
SITE_HOST=127.0.0.1
# 1 behind nginx: the visitor's address comes from X-Real-IP / X-Forwarded-For
SITE_TRUST_PROXY=1
LOBBY_URL=http://127.0.0.1:8790
# static = /play serves client/dist/index.html; proxy = Vite's dev server; link = redirect to GAME_URL
GAME_MODE=static
GAME_INDEX_FILE=/opt/spacegame/client/dist/index.html
SITE_DATA_DIR=/opt/spacegame/data/site
SITE_PROFILES_DIR=/opt/spacegame/data/profiles
SITE_STATUS_FILE=/opt/spacegame/data/status/live.json

# The name shown on a post written by an account (account=Name, comma separated; default admin=Kieran)
# SITE_AUTHORS=admin=Kieran

# --- Optional: PostgreSQL instead of data/site/site.json (npm install pg in site/, apply site/schema.sql) ---
# SITE_STORE_BACKEND=postgres
# DATABASE_URL=postgres://user:password@127.0.0.1:5432/spacegame

# --- Posting updates from a terminal (scripts/post-update.ts; not read by the server) ---
# A token made in the admin panel (Admin, API tokens), or sign in as an admin for the run
# SITE_URL=https://space.brotherk3d.com
# SITE_TOKEN=sgs_...
# SITE_USER=
# SITE_PASSWORD=

# --- Features that wait for the game (docs/game-integration.md) ---
# The game server's key for sharing ships to the gallery (POST /api/v1/ships). 32+ random characters; unset = off
# SITE_GAME_KEY=
# A catalog the game writes (parts, items, ships, bosses, stations). Unset: ../data/catalog/catalog.json, else the site's own snapshot
# SITE_CATALOG_FILE=/opt/spacegame/data/catalog/catalog.json
