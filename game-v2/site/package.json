{
  "name": "@space-game/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The game's website: updates, community, accounts and the way into the game",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit -p .",
    "post-update": "tsx scripts/post-update.ts",
    "build-catalog": "tsx scripts/build-catalog.ts",
    "build-part-images": "node scripts/build-part-images.mjs"
  },
  "dependencies": {
    "marked": "^12.0.2",
    "sanitize-html": "^2.13.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/sanitize-html": "^2.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
